{
  "_doc": [
    "ChromaPrint3D process patch definitions (plan v13 §3.2).",
    "Schema:",
    "  process_common: applied to all (machine × nozzle × face) combinations",
    "  process_per_nozzle.<nozzle>: applied for that nozzle, overrides process_common",
    "  process_per_face.<face>: applied for that face, overrides earlier layers",
    "  filament_common: applied to all filament arrays (currently empty - ChromaPrint3D",
    "                   does not modify filament_options_with_variant fields)",
    "Field categories (per BambuStudio PrintConfig.cpp):",
    "  scalar       : single value, e.g. 'arachne'",
    "  $variant_indexed: dict {variant_name: value} resolved at runtime by",
    "                   base_dict['print_extruder_variant'][i] -> dict[variant_name]",
    "                   (kPrintWithVariantKeys, length = K_process)",
    "Template variables: ${layer_height} replaced at runtime."
  ],
  "process_common": {
    "wall_generator": "arachne",
    "wall_loops": "1",
    "bottom_color_penetration_layers": "1",
    "top_color_penetration_layers": "1",
    "bottom_shell_layers": "1",
    "top_shell_layers": "0",
    "elefant_foot_compensation": "0",
    "initial_layer_flow_ratio": "1.2",
    "sparse_infill_density": "100%",
    "sparse_infill_pattern": "zig-zag",
    "top_surface_pattern": "zig-zag",
    "bottom_surface_pattern": "zig-zag",
    "skeleton_infill_density": "100%",
    "skin_infill_density": "100%",
    "min_bead_width": "65%",
    "prime_tower_width": "200",
    "prime_tower_rib_wall": "0",
    "prime_tower_fillet_wall": "1",
    "detect_narrow_internal_solid_infill": "0",
    "outer_wall_speed": {
      "$variant_indexed": {
        "Direct Drive Standard": "50",
        "Direct Drive High Flow": "60",
        "Direct Drive TPU High Flow": "50",
        "Bowden Standard": "50",
